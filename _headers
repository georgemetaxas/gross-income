# Cloudflare Pages response headers.
# The app shell must never be served stale, or the PWA "new version" bar lags behind deploys.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Icons rarely change; let browsers keep them for a week.
/icons/*
  Cache-Control: public, max-age=604800

# Link preview images. A day, so a redesign shows up in fresh shares quickly.
/social/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  # Only these hosts can run scripts, receive data or frame the login check. Adding a
  # new outside service (ads, analytics) means adding its host here too.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://pngsoygqbvhlfkzdghtr.supabase.co wss://pngsoygqbvhlfkzdghtr.supabase.co https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Self-hosted fonts never change under the same name; a new font gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
